  "info": {
    "_postman_id": "6af138a0-6b2a-4a2c-8ee7-b90428ee8272",
    "name": "Google Analytics Data V1beta API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Google Analytics Data API v1 provides programmatic methods to access\nreport data in Google Analytics 4 (GA4) properties. Use it to build custom\nreports, run pivot reports, batch run reports, query real-time event data,\nfetch dimension/metric metadata, and create audience exports.\n",
      "type": "text/plain"
    }
  }
